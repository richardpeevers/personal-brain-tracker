<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Monthly check-in</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Lora:ital,wght@0,400;0,500;1,400&family=DM+Mono:wght@400;500&display=swap" rel="stylesheet">
<style>
/* ── CONFIG NOTE ───────────────────────────────────────────────
   Replace WORKER_URL below with your Cloudflare Worker URL.
   That's the only line you need to change in this file.
─────────────────────────────────────────────────────────────── */

*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

:root {
  --ink:        #1a1a18;
  --ink-mid:    #4a4a44;
  --ink-faint:  #9a9a90;
  --rule:       rgba(0,0,0,0.10);
  --surface:    #f7f5f0;
  --page:       #fdfcf8;
  --accent:     #2d6a4f;
  --accent-lt:  #d8ede4;
  --warn:       #92400e;
  --warn-lt:    #fef3c7;
  --danger:     #991b1b;
  --danger-lt:  #fee2e2;
  --radius:     6px;
}

@media (prefers-color-scheme: dark) {
  :root {
    --ink:        #e8e6e0;
    --ink-mid:    #a8a69e;
    --ink-faint:  #606058;
    --rule:       rgba(255,255,255,0.09);
    --surface:    #1e1d1a;
    --page:       #171613;
    --accent:     #52b788;
    --accent-lt:  #1a3328;
    --warn:       #d97706;
    --warn-lt:    #2d2000;
    --danger:     #f87171;
    --danger-lt:  #2d0a0a;
  }
}

html { font-size: 16px; }
body {
  font-family: 'Lora', Georgia, serif;
  background: var(--page);
  color: var(--ink);
  min-height: 100vh;
  padding: 3rem 1.25rem 6rem;
}

.wrap { max-width: 580px; margin: 0 auto; }

/* header */
.masthead { margin-bottom: 3rem; }
.masthead h1 {
  font-size: 1.125rem;
  font-weight: 400;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: var(--ink-faint);
  font-family: 'DM Mono', monospace;
}
.masthead .subtitle {
  font-size: 1.5rem;
  font-weight: 500;
  margin-top: 4px;
  color: var(--ink);
}

/* nav */
nav {
  display: flex;
  gap: 0;
  margin-bottom: 3rem;
  border-bottom: 1px solid var(--rule);
}
nav button {
  background: none;
  border: none;
  border-bottom: 2px solid transparent;
  padding: 8px 18px 10px;
  margin-bottom: -1px;
  font-family: 'DM Mono', monospace;
  font-size: 0.75rem;
  letter-spacing: 0.06em;
  color: var(--ink-faint);
  cursor: pointer;
  text-transform: uppercase;
  transition: color 0.15s;
}
nav button:hover { color: var(--ink-mid); }
nav button.active { color: var(--ink); border-bottom-color: var(--accent); }

/* pages */
.page { display: none; animation: fadein 0.2s ease; }
.page.active { display: block; }
@keyframes fadein { from { opacity: 0; transform: translateY(4px); } to { opacity: 1; transform: none; } }

/* section labels */
.eyebrow {
  font-family: 'DM Mono', monospace;
  font-size: 0.68rem;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: var(--ink-faint);
  margin-bottom: 1rem;
}

/* questions */
.q-block { margin-bottom: 2rem; }
.q-text {
  font-size: 1rem;
  line-height: 1.65;
  margin-bottom: 0.875rem;
  color: var(--ink);
}
.scale-row { display: flex; gap: 6px; }
.scale-btn {
  flex: 1;
  padding: 9px 0;
  background: var(--surface);
  border: 1px solid var(--rule);
  border-radius: var(--radius);
  font-family: 'DM Mono', monospace;
  font-size: 0.9rem;
  color: var(--ink-mid);
  cursor: pointer;
  transition: all 0.12s;
}
.scale-btn:hover { border-color: var(--accent); color: var(--ink); }
.scale-btn.sel { background: var(--accent-lt); border-color: var(--accent); color: var(--accent); font-weight: 500; }
.scale-labels { display: flex; justify-content: space-between; margin-top: 5px; font-family: 'DM Mono', monospace; font-size: 0.65rem; color: var(--ink-faint); letter-spacing: 0.04em; }

hr.rule { border: none; border-top: 1px solid var(--rule); margin: 2rem 0; }

/* lifestyle grid */
.ls-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-bottom: 2rem; }
.ls-card {
  background: var(--surface);
  border: 1px solid var(--rule);
  border-radius: var(--radius);
  padding: 14px;
}
.ls-label {
  font-family: 'DM Mono', monospace;
  font-size: 0.7rem;
  letter-spacing: 0.07em;
  text-transform: uppercase;
  color: var(--ink-mid);
  margin-bottom: 10px;
}
.pill-row { display: flex; gap: 5px; flex-wrap: wrap; }
.pill {
  padding: 4px 11px;
  border: 1px solid var(--rule);
  border-radius: 20px;
  font-family: 'DM Mono', monospace;
  font-size: 0.7rem;
  color: var(--ink-faint);
  background: none;
  cursor: pointer;
  transition: all 0.12s;
}
.pill:hover { color: var(--ink); border-color: var(--ink-mid); }
.pill.sel { background: var(--accent-lt); border-color: var(--accent); color: var(--accent); }

/* note */
textarea {
  width: 100%;
  background: var(--surface);
  border: 1px solid var(--rule);
  border-radius: var(--radius);
  padding: 12px 14px;
  font-family: 'Lora', serif;
  font-size: 0.95rem;
  color: var(--ink);
  resize: none;
  min-height: 90px;
  margin-bottom: 1.5rem;
  line-height: 1.6;
}
textarea:focus { outline: none; border-color: var(--accent); }
textarea::placeholder { color: var(--ink-faint); font-style: italic; }

/* submit */
.submit-btn {
  width: 100%;
  padding: 13px;
  background: var(--accent);
  border: none;
  border-radius: var(--radius);
  font-family: 'DM Mono', monospace;
  font-size: 0.8rem;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: #fff;
  cursor: pointer;
  transition: opacity 0.15s, transform 0.12s;
}
.submit-btn:hover { opacity: 0.88; }
.submit-btn:active { transform: scale(0.99); }
.submit-btn:disabled { opacity: 0.45; cursor: not-allowed; }

/* secondary btn */
.ghost-btn {
  background: none;
  border: 1px solid var(--rule);
  border-radius: var(--radius);
  padding: 9px 18px;
  font-family: 'DM Mono', monospace;
  font-size: 0.72rem;
  letter-spacing: 0.07em;
  text-transform: uppercase;
  color: var(--ink-mid);
  cursor: pointer;
  transition: all 0.12s;
}
.ghost-btn:hover { border-color: var(--ink-mid); color: var(--ink); }

/* alerts */
.alert {
  padding: 13px 16px;
  border-radius: var(--radius);
  margin-bottom: 1.25rem;
  font-size: 0.9rem;
  line-height: 1.6;
  border-left: 3px solid;
}
.alert-good    { background: var(--accent-lt); border-color: var(--accent);  color: var(--accent); }
.alert-warn    { background: var(--warn-lt);   border-color: var(--warn);    color: var(--warn); }
.alert-danger  { background: var(--danger-lt); border-color: var(--danger);  color: var(--danger); }
.alert-neutral { background: var(--surface);   border-color: var(--rule);    color: var(--ink-mid); }

/* metrics */
.metric-row { display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; margin-bottom: 2rem; }
.metric {
  background: var(--surface);
  border: 1px solid var(--rule);
  border-radius: var(--radius);
  padding: 14px 12px;
  text-align: center;
}
.metric-val { font-size: 1.5rem; font-weight: 500; color: var(--ink); }
.metric-lbl { font-family: 'DM Mono', monospace; font-size: 0.65rem; letter-spacing: 0.07em; text-transform: uppercase; color: var(--ink-faint); margin-top: 3px; }

/* chart */
.chart-wrap { position: relative; height: 200px; margin-bottom: 2.5rem; }

/* history */
.hist-row {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  padding: 13px 0;
  border-bottom: 1px solid var(--rule);
  gap: 12px;
}
.hist-date { font-family: 'DM Mono', monospace; font-size: 0.75rem; color: var(--ink-mid); white-space: nowrap; }
.hist-note { font-size: 0.85rem; color: var(--ink-faint); font-style: italic; flex: 1; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; margin: 0 12px; }
.hist-score { font-family: 'DM Mono', monospace; font-size: 0.85rem; font-weight: 500; white-space: nowrap; }
.c-good   { color: var(--accent); }
.c-warn   { color: var(--warn); }
.c-danger { color: var(--danger); }

/* pillars */
.pillar-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-bottom: 2rem; }
.pillar {
  background: var(--surface);
  border: 1px solid var(--rule);
  border-radius: var(--radius);
  padding: 14px;
}
.pillar-name { font-family: 'DM Mono', monospace; font-size: 0.68rem; letter-spacing: 0.07em; text-transform: uppercase; color: var(--ink-mid); margin-bottom: 8px; }
.bar-bg { height: 3px; background: var(--rule); border-radius: 2px; margin-bottom: 6px; }
.bar-fg { height: 3px; border-radius: 2px; transition: width 0.5s ease; }
.pillar-score { font-family: 'DM Mono', monospace; font-size: 0.72rem; color: var(--ink-faint); }

/* empty / success */
.empty { text-align: center; padding: 4rem 1rem; color: var(--ink-faint); font-family: 'DM Mono', monospace; font-size: 0.8rem; letter-spacing: 0.05em; line-height: 2; }
.success { text-align: center; padding: 3rem 1rem; }
.success-icon { font-size: 2.5rem; color: var(--accent); margin-bottom: 1rem; }
.success h2 { font-size: 1.25rem; font-weight: 500; margin-bottom: 0.5rem; }
.success p { color: var(--ink-mid); font-size: 0.95rem; max-width: 320px; margin: 0 auto 1.5rem; line-height: 1.7; }

/* settings */
.setting-row { display: flex; justify-content: space-between; align-items: center; padding: 14px 0; border-bottom: 1px solid var(--rule); gap: 16px; }
.setting-info { flex: 1; }
.setting-lbl { font-size: 0.95rem; color: var(--ink); margin-bottom: 2px; }
.setting-sub { font-family: 'DM Mono', monospace; font-size: 0.68rem; color: var(--ink-faint); letter-spacing: 0.04em; }
.toggle { position: relative; width: 38px; height: 22px; flex-shrink: 0; }
.toggle input { opacity: 0; width: 0; height: 0; }
.tog-sl { position: absolute; inset: 0; background: var(--rule); border-radius: 11px; cursor: pointer; transition: background 0.2s; border: 1px solid var(--rule); }
.tog-sl::before { content: ''; position: absolute; width: 16px; height: 16px; left: 2px; top: 2px; background: var(--ink-faint); border-radius: 50%; transition: left 0.2s, background 0.2s; }
.toggle input:checked + .tog-sl { background: var(--accent-lt); border-color: var(--accent); }
.toggle input:checked + .tog-sl::before { left: 18px; background: var(--accent); }

.notice { font-family: 'DM Mono', monospace; font-size: 0.68rem; color: var(--ink-faint); line-height: 1.9; letter-spacing: 0.03em; margin-top: 2rem; padding-top: 1.5rem; border-top: 1px solid var(--rule); }

/* sync status */
.sync-badge {
  display: inline-flex;
  align-items: center;
  gap: 5px;
  font-family: 'DM Mono', monospace;
  font-size: 0.65rem;
  letter-spacing: 0.06em;
  padding: 3px 9px;
  border-radius: 20px;
  margin-left: 10px;
  vertical-align: middle;
}
.sync-ok     { background: var(--accent-lt); color: var(--accent); }
.sync-fail   { background: var(--danger-lt); color: var(--danger); }
.sync-local  { background: var(--warn-lt);   color: var(--warn); }
.sync-dot { width: 5px; height: 5px; border-radius: 50%; background: currentColor; }
</style>
</head>
<body>
<div class="wrap">

  <div class="masthead">
    <div class="h1">Personal Brain</div>
    <div class="subtitle">Monthly check-in</div>
  </div>

  <nav>
    <button class="active" onclick="showPage('checkin')">Check-in</button>
    <button onclick="showPage('trends')">Trends</button>
    <button onclick="showPage('pillars')">Pillars</button>
    <button onclick="showPage('settings')">Settings</button>
  </nav>

  <!-- ── CHECK-IN ─────────────────────────────── -->
  <div id="page-checkin" class="page active">

    <div id="form-wrap">
      <p class="eyebrow" id="checkin-date"></p>

      <div class="q-block">
        <p class="q-text">Over the past two weeks, how often have you felt little interest or pleasure in doing things?</p>
        <div class="scale-row" id="q1"></div>
        <div class="scale-labels"><span>Not at all</span><span>Nearly every day</span></div>
      </div>

      <div class="q-block">
        <p class="q-text">How often have you felt down, depressed, or hopeless?</p>
        <div class="scale-row" id="q2"></div>
        <div class="scale-labels"><span>Not at all</span><span>Nearly every day</span></div>
      </div>

      <div class="q-block">
        <p class="q-text">How often have you felt nervous, anxious, or on edge?</p>
        <div class="scale-row" id="q3"></div>
        <div class="scale-labels"><span>Not at all</span><span>Nearly every day</span></div>
      </div>

      <div class="q-block">
        <p class="q-text">How often have you been unable to stop or control worrying?</p>
        <div class="scale-row" id="q4"></div>
        <div class="scale-labels"><span>Not at all</span><span>Nearly every day</span></div>
      </div>

      <hr class="rule">
      <p class="eyebrow">Lifestyle signals this month</p>

      <div class="ls-grid">
        <div class="ls-card"><div class="ls-label">Exercise / week</div>
          <div class="pill-row" id="lf-exercise">
            <button class="pill" data-val="0">None</button>
            <button class="pill" data-val="1">1–2×</button>
            <button class="pill" data-val="2">3–4×</button>
            <button class="pill" data-val="3">5+×</button>
          </div>
        </div>
        <div class="ls-card"><div class="ls-label">Daily walks</div>
          <div class="pill-row" id="lf-walks">
            <button class="pill" data-val="0">Rarely</button>
            <button class="pill" data-val="1">Sometimes</button>
            <button class="pill" data-val="2">Most days</button>
          </div>
        </div>
        <div class="ls-card"><div class="ls-label">Sleep quality</div>
          <div class="pill-row" id="lf-sleep">
            <button class="pill" data-val="0">Poor</button>
            <button class="pill" data-val="1">Mixed</button>
            <button class="pill" data-val="2">Good</button>
          </div>
        </div>
        <div class="ls-card"><div class="ls-label">Connection</div>
          <div class="pill-row" id="lf-social">
            <button class="pill" data-val="0">Low</button>
            <button class="pill" data-val="1">Some</button>
            <button class="pill" data-val="2">Good</button>
          </div>
        </div>
        <div class="ls-card"><div class="ls-label">Escapism use</div>
          <div class="pill-row" id="lf-escapism">
            <button class="pill" data-val="2">Minimal</button>
            <button class="pill" data-val="1">Some</button>
            <button class="pill" data-val="0">Heavy</button>
          </div>
        </div>
        <div class="ls-card"><div class="ls-label">Work stress</div>
          <div class="pill-row" id="lf-work">
            <button class="pill" data-val="2">Managed</button>
            <button class="pill" data-val="1">Elevated</button>
            <button class="pill" data-val="0">High</button>
          </div>
        </div>
      </div>

      <p class="eyebrow">Anything to note?</p>
      <textarea id="ci-note" placeholder="Optional — patterns you noticed, what's weighing on you, what's helping…"></textarea>

      <button class="submit-btn" id="submit-btn" onclick="submitCheckin()">Save check-in</button>
      <div id="submit-status" style="margin-top:10px; font-family:'DM Mono',monospace; font-size:0.72rem; color:var(--ink-faint); min-height:1.2em;"></div>
    </div>

    <div id="success-wrap" style="display:none">
      <div class="success">
        <div class="success-icon">✓</div>
        <h2>Check-in saved</h2>
        <p id="success-msg">Your responses have been recorded.</p>
        <button class="ghost-btn" onclick="showPage('trends')">View trends →</button>
      </div>
    </div>

  </div>

  <!-- ── TRENDS ────────────────────────────────── -->
  <div id="page-trends" class="page">
    <div id="trends-empty" class="empty">
      No check-ins yet.<br>Complete your first check-in to see trends here.
    </div>
    <div id="trends-content" style="display:none">
      <div id="alert-area"></div>
      <p class="eyebrow">Wellbeing score</p>
      <div class="metric-row" id="metric-row"></div>
      <div class="chart-wrap">
        <canvas id="trendChart" role="img" aria-label="Monthly wellbeing scores over time"></canvas>
      </div>
      <p class="eyebrow">History</p>
      <div id="hist-list"></div>
    </div>
  </div>

  <!-- ── PILLARS ───────────────────────────────── -->
  <div id="page-pillars" class="page">
    <div id="pillars-empty" class="empty">Complete a check-in to see your pillar breakdown.</div>
    <div id="pillars-content" style="display:none">
      <p class="eyebrow">Six pillars · most recent check-in</p>
      <div class="pillar-grid" id="pillar-grid"></div>
      <hr class="rule">
      <p style="font-size:0.9rem; color:var(--ink-mid); line-height:1.8;">
        These reflect the six areas your therapist identified as key to sustaining good mental health. A dip in one is a signal worth noticing — not an alarm. The goal is to catch slow drift before it compounds.
      </p>
    </div>
  </div>

  <!-- ── SETTINGS ──────────────────────────────── -->
  <div id="page-settings" class="page">
    <p class="eyebrow">Notion sync</p>

    <div class="setting-row">
      <div class="setting-info">
        <div class="setting-lbl">Worker URL</div>
        <div class="setting-sub">Your Cloudflare Worker endpoint</div>
      </div>
      <input id="worker-url" type="url" placeholder="https://mh-proxy.name.workers.dev"
        style="width:260px; padding:7px 10px; background:var(--surface); border:1px solid var(--rule); border-radius:var(--radius); font-family:'DM Mono',monospace; font-size:0.72rem; color:var(--ink);"
        oninput="saveSettings()">
    </div>

    <div class="setting-row">
      <div class="setting-info">
        <div class="setting-lbl">Sync to Notion</div>
        <div class="setting-sub">Send each check-in to your Personal Brain database</div>
      </div>
      <label class="toggle"><input type="checkbox" id="toggle-notion" checked onchange="saveSettings()"><span class="tog-sl"></span></label>
    </div>

    <div class="setting-row">
      <div class="setting-info">
        <div class="setting-lbl">Test connection</div>
        <div class="setting-sub">Verify your Worker URL is reachable</div>
      </div>
      <button class="ghost-btn" onclick="testConnection()">Test →</button>
    </div>

    <hr class="rule">
    <p class="eyebrow">Alerts</p>

    <div class="setting-row">
      <div class="setting-info">
        <div class="setting-lbl">Drift alert</div>
        <div class="setting-sub">Flag when score rises more than 30% above personal best</div>
      </div>
      <label class="toggle"><input type="checkbox" id="toggle-drift" checked onchange="saveSettings()"><span class="tog-sl"></span></label>
    </div>

    <div class="setting-row">
      <div class="setting-info">
        <div class="setting-lbl">Lifestyle alerts</div>
        <div class="setting-sub">Flag when exercise or sleep signals worsen</div>
      </div>
      <label class="toggle"><input type="checkbox" id="toggle-ls" checked onchange="saveSettings()"><span class="tog-sl"></span></label>
    </div>

    <hr class="rule">
    <p class="eyebrow">Data</p>

    <div class="setting-row">
      <div class="setting-info">
        <div class="setting-lbl">Export history</div>
        <div class="setting-sub">Download JSON to share with your therapist</div>
      </div>
      <button class="ghost-btn" onclick="exportData()">Export →</button>
    </div>

    <div class="setting-row">
      <div class="setting-info">
        <div class="setting-lbl">Load sample data</div>
        <div class="setting-sub">Populate with six months of example history</div>
      </div>
      <button class="ghost-btn" onclick="loadSample()">Load →</button>
    </div>

    <div class="setting-row" style="border:none">
      <div class="setting-info">
        <div class="setting-lbl" style="color:var(--danger)">Clear all data</div>
        <div class="setting-sub">Remove all locally stored check-ins</div>
      </div>
      <button class="ghost-btn" style="color:var(--danger); border-color:var(--danger)" onclick="clearData()">Clear →</button>
    </div>

    <div class="notice">
      All data is stored in your browser's localStorage and, when Notion sync is enabled,<br>
      written to your Personal Brain database. Nothing is sent to any other server.<br><br>
      This is a personal tracking tool — not a clinical assessment.<br>
      Always work with your therapist and psychiatrist on clinical decisions.
    </div>
  </div>

</div><!-- /wrap -->

<script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.1/chart.umd.js"></script>
<script>
// ─── CONFIG ────────────────────────────────────────────────────
// Paste your Cloudflare Worker URL here as the default,
// or leave blank and enter it in Settings.
const DEFAULT_WORKER_URL = '';
// ───────────────────────────────────────────────────────────────

const STORE_KEY    = 'mhtracker_v2';
const SETTINGS_KEY = 'mhtracker_settings';

let db       = JSON.parse(localStorage.getItem(STORE_KEY)    || '{"entries":[]}');
let settings = JSON.parse(localStorage.getItem(SETTINGS_KEY) || '{}');

if (!settings.workerUrl)    settings.workerUrl    = DEFAULT_WORKER_URL;
if (settings.notionEnabled  === undefined) settings.notionEnabled  = true;
if (settings.driftAlert     === undefined) settings.driftAlert     = true;
if (settings.lifestyleAlert === undefined) settings.lifestyleAlert = true;

function saveDb()       { localStorage.setItem(STORE_KEY,    JSON.stringify(db)); }
function saveSettings() {
  settings.workerUrl       = document.getElementById('worker-url').value.trim();
  settings.notionEnabled   = document.getElementById('toggle-notion').checked;
  settings.driftAlert      = document.getElementById('toggle-drift').checked;
  settings.lifestyleAlert  = document.getElementById('toggle-ls').checked;
  localStorage.setItem(SETTINGS_KEY, JSON.stringify(settings));
}

// ─── NAV ───────────────────────────────────────────────────────
function showPage(id) {
  document.querySelectorAll('.page').forEach(p => p.classList.remove('active'));
  document.querySelectorAll('nav button').forEach(b => b.classList.remove('active'));
  document.getElementById('page-' + id).classList.add('active');
  document.querySelectorAll('nav button').forEach(b => {
    if (b.textContent.toLowerCase() === id) b.classList.add('active');
  });
  if (id === 'trends')   renderTrends();
  if (id === 'pillars')  renderPillars();
  if (id === 'settings') applySettings();
}

// ─── FORM SETUP ────────────────────────────────────────────────
const answers   = { q1: null, q2: null, q3: null, q4: null };
const lifestyle = { exercise: null, walks: null, sleep: null, social: null, escapism: null, work: null };

function makeScale(id) {
  const el = document.getElementById(id);
  ['0','1','2','3'].forEach(v => {
    const b = document.createElement('button');
    b.className = 'scale-btn';
    b.textContent = v;
    b.onclick = () => {
      el.querySelectorAll('.scale-btn').forEach(x => x.classList.remove('sel'));
      b.classList.add('sel');
      answers[id] = +v;
    };
    el.appendChild(b);
  });
}

function makePills(key) {
  document.getElementById('lf-' + key).querySelectorAll('.pill').forEach(p => {
    p.onclick = () => {
      document.getElementById('lf-' + key).querySelectorAll('.pill').forEach(x => x.classList.remove('sel'));
      p.classList.add('sel');
      lifestyle[key] = +p.dataset.val;
    };
  });
}

// ─── SUBMIT ────────────────────────────────────────────────────
async function submitCheckin() {
  const allAnswered = Object.values(answers).every(v => v !== null) &&
                      Object.values(lifestyle).every(v => v !== null);
  if (!allAnswered) { alert('Please answer all questions before saving.'); return; }

  const btn = document.getElementById('submit-btn');
  const status = document.getElementById('submit-status');
  btn.disabled = true;
  btn.textContent = 'Saving…';

  const entry = {
    date:      new Date().toISOString(),
    answers:   { ...answers },
    lifestyle: { ...lifestyle },
    mhScore:   Object.values(answers).reduce((a, b) => a + b, 0),
    lsScore:   Object.values(lifestyle).reduce((a, b) => a + b, 0),
    note:      document.getElementById('ci-note').value.trim(),
    synced:    false,
  };

  db.entries.push(entry);
  saveDb();

  let notionOk = false;
  const workerUrl = settings.workerUrl;

  if (settings.notionEnabled && workerUrl) {
    status.textContent = 'Syncing to Notion…';
    try {
      const res = await fetch(workerUrl, {
        method:  'POST',
        headers: { 'Content-Type': 'application/json' },
        body:    JSON.stringify(entry),
      });
      if (res.ok) {
        db.entries[db.entries.length - 1].synced = true;
        saveDb();
        notionOk = true;
      }
    } catch (e) {
      console.warn('Notion sync failed:', e);
    }
  }

  document.getElementById('form-wrap').style.display = 'none';
  document.getElementById('success-wrap').style.display = 'block';

  const msg = settings.notionEnabled && workerUrl
    ? (notionOk ? 'Saved locally and synced to your Notion Personal Brain.' : 'Saved locally. Notion sync failed — check your Worker URL in Settings.')
    : 'Saved locally. Enable Notion sync in Settings to write to your Personal Brain.';
  document.getElementById('success-msg').textContent = msg;

  btn.disabled = false;
  btn.textContent = 'Save check-in';
}

// ─── TRENDS ────────────────────────────────────────────────────
let trendChart = null;

function renderTrends() {
  const entries = db.entries;
  if (!entries.length) {
    document.getElementById('trends-empty').style.display = 'block';
    document.getElementById('trends-content').style.display = 'none';
    return;
  }
  document.getElementById('trends-empty').style.display = 'none';
  document.getElementById('trends-content').style.display = 'block';

  const latest = entries[entries.length - 1];
  const prev   = entries.length > 1 ? entries[entries.length - 2] : null;
  const best   = Math.min(...entries.map(e => e.mhScore));
  const avg    = Math.round(entries.reduce((a, e) => a + e.mhScore, 0) / entries.length);
  const trendTxt = !prev ? '—' : latest.mhScore < prev.mhScore ? '↓ Improving' : latest.mhScore > prev.mhScore ? '↑ Watch' : '→ Stable';

  document.getElementById('metric-row').innerHTML = `
    <div class="metric"><div class="metric-val">${latest.mhScore}<span style="font-size:0.9rem;opacity:.5">/12</span></div><div class="metric-lbl">Latest</div></div>
    <div class="metric"><div class="metric-val">${avg}<span style="font-size:0.9rem;opacity:.5">/12</span></div><div class="metric-lbl">Average</div></div>
    <div class="metric"><div class="metric-val" style="font-size:1rem;">${trendTxt}</div><div class="metric-lbl">Trend</div></div>
  `;

  const alerts = [];
  if (settings.driftAlert && prev && latest.mhScore > best * 1.3 && latest.mhScore > 4)
    alerts.push({ cls: 'alert-warn', txt: 'Score is drifting above your personal best. Worth discussing with your therapist.' });
  if (settings.driftAlert && prev && latest.mhScore > prev.mhScore + 3)
    alerts.push({ cls: 'alert-warn', txt: 'Meaningful increase in score since last month — a signal worth noticing.' });
  if (settings.lifestyleAlert && latest.lifestyle.exercise === 0)
    alerts.push({ cls: 'alert-neutral', txt: 'No exercise recorded this month. This has been one of your key pillars.' });
  if (settings.lifestyleAlert && latest.lifestyle.sleep === 0)
    alerts.push({ cls: 'alert-neutral', txt: 'Sleep quality logged as poor. Sleep and mood are closely linked.' });

  document.getElementById('alert-area').innerHTML = alerts.length
    ? alerts.map(a => `<div class="alert ${a.cls}">${a.txt}</div>`).join('')
    : `<div class="alert alert-good">No drift signals detected — things look stable.</div>`;

  const labels = entries.map(e => new Date(e.date).toLocaleDateString('en-GB', { month: 'short', year: '2-digit' }));
  const scores = entries.map(e => e.mhScore);
  const dark   = matchMedia('(prefers-color-scheme: dark)').matches;
  const gc     = dark ? 'rgba(255,255,255,0.07)' : 'rgba(0,0,0,0.06)';
  const tc     = dark ? 'rgba(255,255,255,0.35)' : 'rgba(0,0,0,0.35)';

  if (trendChart) trendChart.destroy();
  trendChart = new Chart(document.getElementById('trendChart'), {
    type: 'line',
    data: {
      labels,
      datasets: [{
        data: scores,
        borderColor: '#2d6a4f',
        backgroundColor: dark ? 'rgba(45,106,79,0.15)' : 'rgba(45,106,79,0.08)',
        fill: true,
        tension: 0.35,
        pointRadius: 4,
        pointBackgroundColor: '#2d6a4f',
        borderWidth: 1.5,
      }]
    },
    options: {
      responsive: true,
      maintainAspectRatio: false,
      plugins: { legend: { display: false } },
      scales: {
        y: {
          min: 0, max: 12,
          grid: { color: gc },
          ticks: { color: tc, stepSize: 3, callback: v => v === 0 ? 'Best' : v === 12 ? 'Worst' : v }
        },
        x: { grid: { display: false }, ticks: { color: tc } }
      }
    }
  });

  document.getElementById('hist-list').innerHTML = [...entries].reverse().map(e => {
    const d   = new Date(e.date).toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
    const cls = e.mhScore <= 4 ? 'c-good' : e.mhScore <= 8 ? 'c-warn' : 'c-danger';
    const sync = e.synced ? '<span style="font-size:0.6rem;color:var(--accent)">● notion</span>' : '';
    return `<div class="hist-row">
      <span class="hist-date">${d}</span>
      ${e.note ? `<span class="hist-note">${e.note}</span>` : '<span class="hist-note"></span>'}
      <span class="hist-score ${cls}">${e.mhScore}/12 ${sync}</span>
    </div>`;
  }).join('');
}

// ─── PILLARS ───────────────────────────────────────────────────
function renderPillars() {
  const entries = db.entries;
  if (!entries.length) {
    document.getElementById('pillars-empty').style.display = 'block';
    document.getElementById('pillars-content').style.display = 'none';
    return;
  }
  document.getElementById('pillars-empty').style.display = 'none';
  document.getElementById('pillars-content').style.display = 'block';

  const e = entries[entries.length - 1];
  const pillars = [
    { name: 'Mood',            val: 3 - e.answers.q1 - e.answers.q2,                    max: 6,  col: '#2d6a4f' },
    { name: 'Anxiety',         val: 3 - e.answers.q3 - e.answers.q4,                    max: 6,  col: '#378ADD' },
    { name: 'Movement',        val: e.lifestyle.exercise + e.lifestyle.walks,            max: 5,  col: '#1D9E75' },
    { name: 'Sleep',           val: e.lifestyle.sleep,                                  max: 2,  col: '#7F77DD' },
    { name: 'Connection',      val: e.lifestyle.social,                                 max: 2,  col: '#D4537E' },
    { name: 'Stress balance',  val: (e.lifestyle.work || 0) + (e.lifestyle.escapism||0),max: 4,  col: '#BA7517' },
  ];
  document.getElementById('pillar-grid').innerHTML = pillars.map(p => {
    const pct = Math.round(Math.min((p.val / p.max) * 100, 100));
    const lbl = pct >= 70 ? 'Good' : pct >= 40 ? 'Monitor' : 'Attention';
    return `<div class="pillar">
      <div class="pillar-name">${p.name}</div>
      <div class="bar-bg"><div class="bar-fg" style="width:${pct}%;background:${p.col}"></div></div>
      <div class="pillar-score">${lbl} · ${pct}%</div>
    </div>`;
  }).join('');
}

// ─── SETTINGS ──────────────────────────────────────────────────
function applySettings() {
  document.getElementById('worker-url').value        = settings.workerUrl || '';
  document.getElementById('toggle-notion').checked   = settings.notionEnabled;
  document.getElementById('toggle-drift').checked    = settings.driftAlert;
  document.getElementById('toggle-ls').checked       = settings.lifestyleAlert;
}

async function testConnection() {
  const url = document.getElementById('worker-url').value.trim();
  if (!url) { alert('Enter your Worker URL first.'); return; }
  try {
    const res = await fetch(url, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ _test: true, date: new Date().toISOString(), mhScore: 0, lsScore: 0, answers: {}, lifestyle: {}, note: 'connection test' }),
    });
    alert(res.ok ? '✓ Connected — Worker is reachable.' : `✗ Worker returned ${res.status}. Check your token and database ID.`);
  } catch {
    alert('✗ Could not reach Worker. Check the URL and that the Worker is deployed.');
  }
}

// ─── EXPORT / CLEAR / SAMPLE ───────────────────────────────────
function exportData() {
  const blob = new Blob([JSON.stringify(db, null, 2)], { type: 'application/json' });
  const a = document.createElement('a');
  a.href = URL.createObjectURL(blob);
  a.download = `mh-tracker-${new Date().toISOString().slice(0,10)}.json`;
  a.click();
}

function clearData() {
  if (confirm('Clear all local check-in data? Notion records are not affected.')) {
    db = { entries: [] };
    saveDb();
    document.getElementById('form-wrap').style.display = 'block';
    document.getElementById('success-wrap').style.display = 'none';
    showPage('checkin');
  }
}

function loadSample() {
  if (!confirm('Load six months of sample data? This will replace existing local entries.')) return;
  const now = new Date();
  db.entries = [5,4,3,2,1,0].map((mo, i) => {
    const d = new Date(now);
    d.setMonth(d.getMonth() - mo);
    const drift = i < 2 ? [2,2,2,2] : i < 4 ? [1,1,1,1] : [0,0,0,0];
    return {
      date:      d.toISOString(),
      answers:   { q1: drift[0], q2: drift[1], q3: drift[2], q4: drift[3] },
      lifestyle: { exercise: i<2?0:i<4?1:2, walks: i<3?0:2, sleep: i<2?0:i<4?1:2, social: i<3?0:1, escapism: i<2?0:i<4?1:2, work: i<3?0:1 },
      mhScore:   drift.reduce((a,b)=>a+b,0),
      lsScore:   0,
      note:      i===5?'Feeling noticeably better — less avoidance, more present.':i===1?'Hard month. Work overload and not sleeping well.':'',
      synced:    false,
    };
  });
  saveDb();
  showPage('trends');
}

// ─── INIT ──────────────────────────────────────────────────────
document.getElementById('checkin-date').textContent =
  new Date().toLocaleDateString('en-GB', { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric' });

['q1','q2','q3','q4'].forEach(makeScale);
['exercise','walks','sleep','social','escapism','work'].forEach(makePills);
applySettings();
</script>
